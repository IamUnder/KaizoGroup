---
import Icon from './Icon.astro';
import { solutions } from '../data/content';
---

<section id="solucion" class="section-kz border-b border-hairline bg-canvas-deep">
  <div class="container-kz">
    <div class="reveal max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">La solución</p>
      <h2 class="mt-3 text-3xl font-display font-600 text-ink sm:text-4xl">
        [Titular placeholder: qué incluye trabajar con KaizoGroup]
      </h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        solutions.map((item) => (
          <div class="reveal rounded-md bg-surface-card p-6">
            <div class="flex size-10 items-center justify-center rounded-sm bg-surface-card-elevated text-accent">
              <Icon name={item.icon} class="size-5" />
            </div>
            <h3 class="mt-4 font-display text-lg font-600 text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{item.change}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
