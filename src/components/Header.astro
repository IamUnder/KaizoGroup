---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import kaizoMark from '../assets/kaizo-mark.png';
import { siteConfig } from '../lib/site';
import { ui, resolveLang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  /** Ruta COMPLETA (con prefijo de idioma incluido) al equivalente en el otro idioma,
   *  para páginas cuyo slug cambia entre idiomas (ej. legales). Si no se pasa, se deriva
   *  automáticamente asumiendo que la ruta es la misma en ambos idiomas (páginas espejo). */
  altPath?: string;
}

const { altPath } = Astro.props;

const lang = resolveLang(Astro.currentLocale);
const otherLang = lang === 'es' ? 'en' : 'es';
const t = ui[lang];

const mirroredPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const langSwitchHref = altPath ?? getRelativeLocaleUrl(otherLang, mirroredPath);
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas-deep/90 backdrop-blur">
  <div class="container-kz flex h-[72px] items-center justify-between">
    <a href="#main-content" class="flex items-center gap-3 shrink-0" aria-label={t.header.homeAriaLabel}>
      <Image src={kaizoMark} alt="" width={72} height={72} loading="eager" class="size-9 rounded-sm" />
      <span class="font-display text-lg font-600 tracking-tight text-ink">{siteConfig.name}</span>
    </a>

    <nav aria-label={t.header.navAriaLabel} class="hidden items-center gap-6 lg:flex">
      {
        t.nav.map((item) => (
          <a href={item.href} class="font-body text-sm text-body transition-colors hover:text-ink">
            {item.label}
          </a>
        ))
      }
      <a href={langSwitchHref} class="font-mono text-xs uppercase tracking-[0.1em] text-body-soft transition-colors hover:text-ink">
        {t.langSwitch.label}
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <a href="#contacto" class="btn-primary hidden text-sm sm:inline-flex">
        {t.header.ctaLabel}
      </a>

      <!-- Menú móvil sin JS: <details>/<summary> nativo -->
      <details class="relative lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-sm border border-hairline text-ink [&::-webkit-details-marker]:hidden"
          aria-label={t.header.openMenuAriaLabel}
        >
          <Icon name="chevron-down" class="size-5" />
        </summary>
        <nav
          aria-label={t.header.mobileNavAriaLabel}
          class="absolute right-0 top-[calc(100%+8px)] flex w-56 flex-col gap-1 rounded-md border border-hairline bg-surface-card p-2 shadow-lg"
        >
          {
            t.nav.map((item) => (
              <a href={item.href} class="rounded-sm px-3 py-2 text-sm text-body hover:bg-surface-card-elevated hover:text-ink">
                {item.label}
              </a>
            ))
          }
          <a href={langSwitchHref} class="rounded-sm px-3 py-2 font-mono text-xs uppercase tracking-[0.1em] text-body-soft hover:bg-surface-card-elevated hover:text-ink">
            {t.langSwitch.label}
          </a>
          <a href="#contacto" class="btn-primary mt-1 justify-center text-sm">
            {t.header.ctaLabel}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
