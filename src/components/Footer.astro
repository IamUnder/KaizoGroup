---
import { Image } from 'astro:assets';
import kaizoMark from '../assets/kaizo-mark.png';
import { siteConfig } from '../lib/site';
import { ui, resolveLang } from '../i18n/ui';

const lang = resolveLang(Astro.currentLocale);
const t = ui[lang];

const currentYear = new Date().getFullYear();

const socialLinks = Object.entries(siteConfig.social).filter(([, url]) => url);

// Mismo problema que en Header: t.nav son anclas (#solucion...) que solo existen en la home.
const mirroredPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const isHome = mirroredPath === '/';
const homePath = lang === 'en' ? '/en' : '';
const sectionHref = (hash: string) => (isHome ? hash : `${homePath}/${hash}`);
---

<footer class="bg-canvas-deep">
  <div class="container-kz grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-3">
        <Image src={kaizoMark} alt="" width={56} height={56} loading="lazy" class="size-7 rounded-sm" />
        <span class="font-display text-base font-600 text-ink">{siteConfig.name}</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-body-soft">{t.meta.tagline}</p>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-body-soft">{t.footer.contact}</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={`mailto:${siteConfig.contact.email}`} class="text-body hover:text-ink">
            {siteConfig.contact.email}
          </a>
        </li>
        <li>
          <a href={`tel:${siteConfig.contact.phone.replace(/\s+/g, '')}`} class="text-body hover:text-ink">
            {siteConfig.contact.phone}
          </a>
        </li>
        {
          siteConfig.contact.googleBusinessUrl && (
            <li>
              <a href={siteConfig.contact.googleBusinessUrl} target="_blank" rel="noopener noreferrer" class="text-body hover:text-ink">
                {t.footer.googleBusiness}
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-body-soft">{t.footer.nav}</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {
          t.nav.map((item) => (
            <li>
              <a href={sectionHref(item.href)} class="text-body hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
        {
          t.footer.resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-body hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-body-soft">{t.footer.legal}</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {
          t.footer.legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-body hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        socialLinks.length > 0 && (
          <ul class="mt-5 flex gap-4">
            {socialLinks.map(([key, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener noreferrer" class="text-body-soft hover:text-ink capitalize">
                  {key}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="border-t border-hairline py-6">
    <p class="container-kz text-xs text-body-soft">
      © {currentYear} {siteConfig.name}. {t.footer.rights}
    </p>
  </div>
</footer>
