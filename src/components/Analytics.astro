---
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID as string | undefined;
const umamiSrc =
  (import.meta.env.PUBLIC_UMAMI_SRC as string | undefined) || 'https://cloud.umami.is/script.js';
const clarityId = import.meta.env.PUBLIC_CLARITY_ID as string | undefined;
---

{umamiWebsiteId && <link rel="preconnect" href="https://cloud.umami.is" />}
{clarityId && <link rel="preconnect" href="https://www.clarity.ms" />}

{
  umamiWebsiteId && (
    <script is:inline defer src={umamiSrc} data-website-id={umamiWebsiteId} />
  )
}

{
  // Data island (no ejecutable, la CSP no la restringe) en vez de un script inline con el id
  // horneado — así el bootstrap de Clarity puede vivir en el script procesado de abajo, que sí
  // es un fichero externo 'self', sin necesitar 'unsafe-inline' en script-src.
  clarityId && (
    <script type="application/json" id="kz-clarity-config" set:html={JSON.stringify({ id: clarityId })} is:inline />
  )
}

<script>
  // Delega clics en cualquier elemento con data-analytics-event a Umami,
  // y escucha el evento custom que dispara el formulario de contacto al enviarse con éxito.
  const track = (eventName: string, props?: Record<string, string>) => {
    // @ts-expect-error — umami se inyecta globalmente solo si PUBLIC_UMAMI_WEBSITE_ID está definido
    if (typeof window.umami?.track === 'function') {
      // @ts-expect-error
      window.umami.track(eventName, props);
    }
  };

  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement)?.closest<HTMLElement>('[data-analytics-event]');
    if (!target) return;
    const eventName = target.dataset.analyticsEvent;
    if (!eventName) return;
    const project = target.dataset.analyticsProject;
    track(eventName, project ? { project } : undefined);
  });

  window.addEventListener('kz:analytics', (event) => {
    const detail = (event as CustomEvent<{ event: string }>).detail;
    if (detail?.event) track(detail.event);
  });

  // Clarity: lee el id desde el data island JSON de arriba (si existe) e inyecta su script.
  const clarityConfig = document.getElementById('kz-clarity-config')?.textContent;
  if (clarityConfig) {
    try {
      const { id } = JSON.parse(clarityConfig) as { id?: string };
      if (id) {
        (function (c: any, l: Document, a: string, r: string, i: string) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          const t = l.createElement(r) as HTMLScriptElement;
          t.async = true;
          t.src = 'https://www.clarity.ms/tag/' + i;
          const y = l.getElementsByTagName(r)[0];
          y.parentNode?.insertBefore(t, y);
        })(window, document, 'clarity', 'script', id);
      }
    } catch {
      // JSON malformado — no debería pasar nunca, se genera con JSON.stringify en build time.
    }
  }
</script>
