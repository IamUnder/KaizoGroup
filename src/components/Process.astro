---
import { process } from '../data/content';
---

<section id="proceso" class="section-kz border-b border-hairline bg-canvas-deep">
  <div class="container-kz">
    <div class="reveal max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-body-soft">Proceso de trabajo</p>
      <h2 class="mt-3 text-3xl font-display font-600 text-ink sm:text-4xl">Cómo trabajamos</h2>
    </div>

    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {
        process.map((item, index) => (
          <li class="reveal relative pl-0">
            <div class="flex items-center gap-3">
              <span class="font-mono text-2xl font-500 text-accent">{item.step}</span>
              {index < process.length - 1 && (
                <span class="hidden h-px flex-1 bg-hairline lg:block" aria-hidden="true" />
              )}
            </div>
            <h3 class="mt-4 font-display text-base font-600 text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
