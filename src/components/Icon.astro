---
// Set mínimo de iconos inline (sin librería externa) — trazo, sin relleno, hereda currentColor.
const icons = {
  gauge: 'M12 14 15 9M12 20a8 8 0 1 1 8-8M4.2 12H3M12 4V3M20 12h1.2M6.3 6.3l-.8-.8M17.7 6.3l.8-.8',
  search: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM21 21l-4.35-4.35',
  target: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z',
  wrench: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.8 2.8-2-2 2.8-2.8Z',
  code: 'm9 18-6-6 6-6M15 6l6 6-6 6',
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  refresh: 'M21 12a9 9 0 0 1-15.3 6.4M3 12a9 9 0 0 1 15.3-6.4M21 3v6h-6M3 21v-6h6',
  'chevron-down': 'm6 9 6 6 6-6',
  quote: 'M7 7h4v6H8a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h1M15 7h4v6h-3a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h1',
  mail: 'M4 6h16v12H4zM4 6l8 7 8-7',
  'map-pin': 'M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11ZM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  'arrow-right': 'M4 12h16M13 5l7 7-7 7',
  'external-link': 'M14 4h6v6M20 4 10 14M20 14v6H4V4h6',
  check: 'm5 12 5 5 9-9',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={icons[name]}></path>
</svg>
