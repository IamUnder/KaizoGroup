---
import { ui, resolveLang } from '../i18n/ui';

const lang = resolveLang(Astro.currentLocale);
const t = ui[lang].nexoFeature;
const nexoHref = lang === 'es' ? '/nexo' : '/en/nexo';
const demoHref = lang === 'es' ? '/nexo#contacto' : '/en/nexo#contacto';
---

<section class="section-kz border-b border-hairline bg-canvas">
  <div class="container-kz">
    <div class="reveal overflow-hidden rounded-lg border border-accent/40 bg-surface-card">
      <div class="grid gap-10 p-8 sm:p-12 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{t.eyebrow}</p>
          <h2 class="mt-3 font-display text-3xl font-600 text-ink sm:text-4xl">{t.h2}</h2>
          <p class="mt-4 text-body leading-relaxed">{t.body}</p>

          <div class="mt-6 flex flex-wrap gap-2">
            {
              t.sectors.map((sector) => (
                <span class="rounded-full border border-hairline px-3 py-1 font-mono text-xs text-body-soft">
                  {sector}
                </span>
              ))
            }
          </div>

          <ul class="mt-8 space-y-4">
            {
              t.modules.map((mod) => (
                <li>
                  <p class="font-display text-sm font-600 text-ink">{mod.name}</p>
                  <p class="text-sm text-body-soft">{mod.tagline}</p>
                </li>
              ))
            }
          </ul>

          <div class="mt-9 flex flex-wrap gap-4">
            <a href={nexoHref} class="btn-primary" data-analytics-event="nexo_feature_click">
              {t.ctaPrimary}
            </a>
            <a href={demoHref} class="btn-outline" data-analytics-event="nexo_feature_demo_click">
              {t.ctaSecondary}
            </a>
          </div>
        </div>

        <div class="overflow-hidden rounded-md border border-hairline">
          <img
            src="/portfolio/nexo-dashboard.jpg"
            alt={t.imageAlt}
            width="1264"
            height="790"
            loading="lazy"
            decoding="async"
            class="w-full"
          />
        </div>
      </div>
    </div>
  </div>
</section>
