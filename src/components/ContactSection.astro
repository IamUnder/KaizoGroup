---
import { siteConfig } from '../lib/site';
---

<section id="contacto" class="section-kz border-b border-hairline bg-canvas-deep">
  <div class="container-kz grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
    <div class="reveal">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">Auditoría gratuita</p>
      <h2 class="mt-3 text-3xl font-display font-600 text-ink sm:text-4xl">
        Pide tu auditoría gratuita
      </h2>
      <p class="mt-4 max-w-md text-body">
        Te decimos, sin compromiso, qué está frenando a tu negocio y cómo lo resolveríamos.
        Respondemos por correo o teléfono en menos de 24 horas.
      </p>

      {
        siteConfig.contact.calendlyUrl && (
          <a href={siteConfig.contact.calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn-outline mt-6">
            Agendar una llamada
          </a>
        )
      }
    </div>

    <form
      id="contact-form"
      class="reveal rounded-lg border border-hairline bg-surface-card p-6 sm:p-8"
      novalidate
    >
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <label for="name" class="block text-sm font-500 text-ink">Nombre</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-1">
          <label for="email" class="block text-sm font-500 text-ink">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="business" class="block text-sm font-500 text-ink">Negocio</label>
          <input
            id="business"
            name="business"
            type="text"
            autocomplete="organization"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="message" class="block text-sm font-500 text-ink">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="mt-2 w-full resize-none rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          ></textarea>
        </div>
      </div>

      <button type="submit" class="btn-primary mt-6 w-full sm:w-auto">
        Enviar
      </button>

      <p id="contact-form-status" class="mt-4 text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY as string | undefined;
    if (!accessKey) {
      if (status) {
        status.textContent = 'Formulario sin configurar: falta PUBLIC_WEB3FORMS_ACCESS_KEY en el entorno.';
        status.className = 'mt-4 text-sm text-semantic-error';
      }
      return;
    }

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    submitButton?.setAttribute('disabled', 'true');
    if (status) {
      status.textContent = 'Enviando…';
      status.className = 'mt-4 text-sm text-body';
    }

    const formData = new FormData(form);
    formData.append('access_key', accessKey);
    formData.append('subject', `Nuevo contacto desde la web — ${formData.get('name')}`);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        form.reset();
        if (status) {
          status.textContent = '¡Gracias! Te responderemos en breve.';
          status.className = 'mt-4 text-sm text-semantic-success';
        }
        window.dispatchEvent(new CustomEvent('kz:analytics', { detail: { event: 'contact_form_submit' } }));
      } else {
        throw new Error(result.message ?? 'Error desconocido');
      }
    } catch (error) {
      if (status) {
        status.textContent = 'No se pudo enviar el mensaje. Inténtalo de nuevo o escríbenos por email.';
        status.className = 'mt-4 text-sm text-semantic-error';
      }
    } finally {
      submitButton?.removeAttribute('disabled');
    }
  });
</script>
