---
import { siteConfig } from '../lib/site';
import { ui, resolveLang } from '../i18n/ui';

interface Props {
  /** Diferencia en Portledger de qué página generó el lead (home, /nexo...). */
  source?: string;
}

const { source = 'kaizogroup-web' } = Astro.props;

const lang = resolveLang(Astro.currentLocale);
const t = ui[lang].contact;
---

<section id="contacto" class="section-kz border-b border-hairline bg-canvas-deep">
  <div class="container-kz grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
    <div class="reveal">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{t.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-display font-600 text-ink sm:text-4xl">
        {t.h2}
      </h2>
      <p class="mt-4 max-w-md text-body">
        {t.subtitle}
      </p>

      {
        siteConfig.contact.calendlyUrl && (
          <a href={siteConfig.contact.calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn-outline mt-6">
            {t.calendlyLabel}
          </a>
        )
      }
    </div>

    <form
      id="contact-form"
      class="reveal rounded-lg border border-hairline bg-surface-card p-6 sm:p-8"
      data-i18n-status={JSON.stringify(t.status)}
      data-lang={lang}
      data-source={source}
      novalidate
    >
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        aria-label="No rellenar"
      />

      <!-- Honeypot para el endpoint de leads de Portledger (distinto del "botcheck" de arriba,
           que es el que espera Web3Forms) — debe quedar siempre vacío en un envío real. -->
      <input
        type="text"
        name="website"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        aria-label="No rellenar"
      />

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <label for="name" class="block text-sm font-500 text-ink">{t.form.name}</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-1">
          <label for="email" class="block text-sm font-500 text-ink">{t.form.email}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="business" class="block text-sm font-500 text-ink">{t.form.business}</label>
          <input
            id="business"
            name="business"
            type="text"
            autocomplete="organization"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="message" class="block text-sm font-500 text-ink">{t.form.message}</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="mt-2 w-full resize-none rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          ></textarea>
        </div>
      </div>

      <button type="submit" class="btn-primary mt-6 w-full sm:w-auto">
        {t.form.submit}
      </button>

      <p id="contact-form-status" class="mt-4 text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  import { initLeadForm } from '../scripts/leadSubmit';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');
  // Si se llega desde un artículo del blog (?ref=slug-del-post, ver src/pages/blog/
  // [slug].astro), se añade al "source" para poder distinguir en Portledger qué post
  // trajo el lead — la página en sí sigue siendo estática, esto se resuelve en cliente.
  const ref = new URLSearchParams(location.search).get('ref');
  const source = ref ? `${form?.dataset.source ?? 'kaizogroup-web'}-blog-${ref}` : form?.dataset.source;
  if (form) initLeadForm(form, status, { source });
</script>
