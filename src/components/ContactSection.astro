---
import { siteConfig } from '../lib/site';
import { ui, resolveLang } from '../i18n/ui';

const lang = resolveLang(Astro.currentLocale);
const t = ui[lang].contact;
---

<section id="contacto" class="section-kz border-b border-hairline bg-canvas-deep">
  <div class="container-kz grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
    <div class="reveal">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{t.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-display font-600 text-ink sm:text-4xl">
        {t.h2}
      </h2>
      <p class="mt-4 max-w-md text-body">
        {t.subtitle}
      </p>

      {
        siteConfig.contact.calendlyUrl && (
          <a href={siteConfig.contact.calendlyUrl} target="_blank" rel="noopener noreferrer" class="btn-outline mt-6">
            {t.calendlyLabel}
          </a>
        )
      }
    </div>

    <form
      id="contact-form"
      class="reveal rounded-lg border border-hairline bg-surface-card p-6 sm:p-8"
      data-i18n-status={JSON.stringify(t.status)}
      data-lang={lang}
      novalidate
    >
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        style="display:none"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <!-- Honeypot para el endpoint de leads de Portledger (distinto del "botcheck" de arriba,
           que es el que espera Web3Forms) — debe quedar siempre vacío en un envío real. -->
      <input
        type="text"
        name="website"
        class="hidden"
        style="display:none"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <label for="name" class="block text-sm font-500 text-ink">{t.form.name}</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-1">
          <label for="email" class="block text-sm font-500 text-ink">{t.form.email}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="business" class="block text-sm font-500 text-ink">{t.form.business}</label>
          <input
            id="business"
            name="business"
            type="text"
            autocomplete="organization"
            class="mt-2 w-full rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="message" class="block text-sm font-500 text-ink">{t.form.message}</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="mt-2 w-full resize-none rounded-sm border-0 bg-surface-strong px-4 py-3 text-sm text-ink outline-none focus-visible:ring-2 focus-visible:ring-accent"
          ></textarea>
        </div>
      </div>

      <button type="submit" class="btn-primary mt-6 w-full sm:w-auto">
        {t.form.submit}
      </button>

      <p id="contact-form-status" class="mt-4 text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  interface StatusMessages {
    notConfigured: string;
    sending: string;
    success: string;
    error: string;
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');
  const i18n: StatusMessages = JSON.parse(form?.dataset.i18nStatus || '{}');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY as string | undefined;
    if (!accessKey) {
      if (status) {
        status.textContent = i18n.notConfigured;
        status.className = 'mt-4 text-sm text-semantic-error';
      }
      return;
    }

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    submitButton?.setAttribute('disabled', 'true');
    if (status) {
      status.textContent = i18n.sending;
      status.className = 'mt-4 text-sm text-body';
    }

    const formData = new FormData(form);
    formData.append('access_key', accessKey);
    formData.append('subject', `Nuevo contacto desde la web — ${formData.get('name')}`);

    // Portledger (CRM interno): crea Cliente+Tarea a partir del mismo lead, en paralelo al envío
    // por email. Best-effort a propósito — si falla o no está configurado, no afecta al envío
    // del formulario, que sigue dependiendo únicamente de Web3Forms para la confirmación al usuario.
    const portledgerUrl = import.meta.env.PUBLIC_PORTLEDGER_LEADS_URL as string | undefined;
    const portledgerKey = import.meta.env.PUBLIC_PORTLEDGER_LEADS_KEY as string | undefined;
    if (portledgerUrl && portledgerKey) {
      fetch(portledgerUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Api-Key': portledgerKey },
        body: JSON.stringify({
          name: formData.get('name'),
          email: formData.get('email'),
          business: formData.get('business') || undefined,
          message: formData.get('message'),
          source: 'kaizogroup-web',
          locale: form.dataset.lang || 'es',
          website: formData.get('website') || '',
        }),
      }).catch(() => {});
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const result = await response.json();

      if (result.success) {
        form.reset();
        if (status) {
          status.textContent = i18n.success;
          status.className = 'mt-4 text-sm text-semantic-success';
        }
        window.dispatchEvent(new CustomEvent('kz:analytics', { detail: { event: 'contact_form_submit' } }));
      } else {
        throw new Error(result.message ?? 'Unknown error');
      }
    } catch (error) {
      if (status) {
        status.textContent = i18n.error;
        status.className = 'mt-4 text-sm text-semantic-error';
      }
    } finally {
      submitButton?.removeAttribute('disabled');
    }
  });
</script>
