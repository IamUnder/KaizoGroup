---
import Icon from './Icon.astro';
import { faqs } from '../data/content';
---

<section id="faq" class="section-kz border-b border-hairline bg-canvas">
  <div class="container-kz max-w-3xl">
    <div class="reveal">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-body-soft">FAQ</p>
      <h2 class="mt-3 text-3xl font-display font-600 text-ink sm:text-4xl">Preguntas frecuentes</h2>
    </div>

    <div class="reveal mt-10 divide-y divide-hairline border-t border-b border-hairline">
      {
        faqs.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-base font-600 text-ink">{item.question}</span>
              <Icon name="chevron-down" class="size-5 shrink-0 text-body-soft transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-body">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
