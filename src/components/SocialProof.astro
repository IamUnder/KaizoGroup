---
import Icon from './Icon.astro';
import { getContent } from '../data/content';
import { ui, resolveLang } from '../i18n/ui';

const lang = resolveLang(Astro.currentLocale);
const t = ui[lang].socialProof;
const { testimonials } = getContent(lang);
---

<section id="testimonios" class="section-kz border-b border-hairline bg-canvas">
  <div class="container-kz">
    <div class="reveal max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-body-soft">{t.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-display font-600 text-ink sm:text-4xl">{t.h2}</h2>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {
        testimonials.map((item) => (
          <figure class="reveal rounded-md border border-hairline bg-surface-card p-6">
            <Icon name="quote" class="size-6 text-hairline" />
            <blockquote class="mt-4 text-sm leading-relaxed text-body">{item.quote}</blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              <span class="flex size-9 items-center justify-center rounded-full bg-surface-strong font-mono text-xs text-body">
                {item.author
                  .split(' ')
                  .map((w: string) => w[0])
                  .join('')
                  .slice(0, 2)}
              </span>
              <span>
                <span class="block text-sm font-500 text-ink">{item.author}</span>
                <span class="block text-xs text-body-soft">{item.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
