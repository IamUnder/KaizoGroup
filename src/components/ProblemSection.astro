---
import Icon from './Icon.astro';
import { painPoints } from '../data/content';
---

<section id="problema" class="section-kz border-b border-hairline bg-canvas">
  <div class="container-kz">
    <div class="reveal max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-body-soft">El problema</p>
      <h2 class="mt-3 text-3xl font-display font-600 text-ink sm:text-4xl">
        Lo que frena a la mayoría de negocios
      </h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        painPoints.map((point) => (
          <div class="reveal rounded-md border border-hairline bg-surface-card p-6">
            <Icon name={point.icon} class="size-6 text-body" />
            <h3 class="mt-4 font-display text-lg font-600 text-ink">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{point.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
