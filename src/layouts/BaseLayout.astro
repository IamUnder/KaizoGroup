---
import '../styles/global.css';
import { siteConfig } from '../lib/site';
import { ui, resolveLang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Ruta absoluta o relativa a /public de la imagen OG (1200x630 recomendado) */
  ogImage?: string;
  /** Desactiva el JSON-LD de LocalBusiness en páginas que no lo necesiten (legal, etc.) */
  includeLocalBusinessSchema?: boolean;
  /** Ruta equivalente en el otro idioma (para hreflang) si no se puede derivar automáticamente */
  altPath?: string;
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  includeLocalBusinessSchema = true,
  altPath,
} = Astro.props;

const lang = resolveLang(Astro.currentLocale);
const t = ui[lang];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const pageTitle = title.includes(siteConfig.name) ? title : `${title} · ${siteConfig.name}`;

// hreflang: por defecto, la misma ruta con/sin el prefijo /en (páginas espejo como la home).
// Para páginas cuyo slug cambia entre idiomas (ej. legales), pásalo explícito con `altPath`.
const defaultAltPath =
  lang === 'es' ? `/en${Astro.url.pathname}` : Astro.url.pathname.replace(/^\/en/, '') || '/';
const esPath = lang === 'es' ? Astro.url.pathname : altPath ?? defaultAltPath;
const enPath = lang === 'en' ? Astro.url.pathname : altPath ?? defaultAltPath;
const esURL = new URL(esPath, Astro.site);
const enURL = new URL(enPath, Astro.site);

// Perfiles reales con URL (evita listar redes vacías en sameAs)
const sameAs = Object.values(siteConfig.social).filter(Boolean);

const organizationId = `${siteConfig.url}/#organization`;
const websiteId = `${siteConfig.url}/#website`;

const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': organizationId,
      name: siteConfig.name,
      description,
      url: siteConfig.url,
      inLanguage: lang,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Calle Alcántara, 14',
        addressLocality: 'Puertollano',
        addressRegion: 'Ciudad Real',
        addressCountry: 'ES',
      },
      areaServed: siteConfig.serviceArea.map((area) => ({ '@type': 'City', name: area })),
      about: siteConfig.serviceArea.map((area) => ({ '@type': 'Place', name: area })),
      email: siteConfig.contact.email,
      telephone: siteConfig.contact.phone,
      image: ogImageURL.toString(),
      ...(sameAs.length > 0 && { sameAs }),
      knowsAbout:
        lang === 'es'
          ? ['Desarrollo de software a medida', 'Diseño y desarrollo web', 'SEO técnico', 'Mantenimiento de aplicaciones']
          : ['Custom software development', 'Web design and development', 'Technical SEO', 'Application maintenance'],
      makesOffer:
        lang === 'es'
          ? [
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Desarrollo de software a medida' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Diseño y desarrollo web' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Mantenimiento y soporte de aplicaciones' } },
            ]
          : [
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom software development' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Web design and development' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Application maintenance and support' } },
            ],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteConfig.url,
      name: siteConfig.name,
      inLanguage: lang,
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t.meta.keywords.join(', ')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {
      includeLocalBusinessSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} is:inline />
      )
    }

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:text-accent-ink focus:px-4 focus:py-2 focus:rounded-sm"
    >
      {t.skipToContent}
    </a>
    <slot />

    <script>
      // Fade-up mínimo al entrar en viewport — sin dependencias.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
