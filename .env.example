# Web3Forms — clave pública de acceso (https://web3forms.com), segura para exponer en cliente
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Plausible Analytics — dominio registrado en Plausible (deja vacío para desactivar analítica)
PUBLIC_PLAUSIBLE_DOMAIN=

# Microsoft Clarity — ID de proyecto (opcional, deja vacío para desactivar el mapa de calor)
PUBLIC_CLARITY_ID=

# --- Solo para docker-compose (no las usa `npm run dev`) ---

# Dominio de producción, usado por Traefik/Caddy para enrutar y emitir el certificado TLS
SITE_DOMAIN=kaizogroup.es

# Nombre de la red Docker externa de tu Traefik/PaaS (solo docker-compose.yml, no el standalone)
TRAEFIK_NETWORK=proxy
